{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nothamod6R/raheq-data/database/prayer/schema.json",
  "title": "Raheq prayer-location dataset",
  "description": "Schema of the JSON files in database/prayer/. Field documentation lives in database/prayer/README.md; this file is the machine-readable contract and is enforced by scripts/validate-prayer-data.mjs.",
  "$defs": {
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "countryCode", "latitude", "longitude", "timezone"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "description": "GeoNames id; stable primary key." },
        "name": { "type": "string", "minLength": 1, "description": "Preferred name (utf8)." },
        "ascii": { "type": "string", "description": "ASCII transliteration; present only when it differs from name." },
        "nameAr": { "type": "string", "minLength": 1, "description": "Arabic name (GeoNames ar, else Wikidata)." },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2; keys countries.json." },
        "region": { "type": "string", "description": "First-level administrative division name (English)." },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "population": { "type": "integer", "minimum": 1 },
        "timezone": { "type": "string", "minLength": 1, "description": "IANA time zone id; keys timezones.json." },
        "method": { "type": "string", "description": "City-level calculation-method override; keys methods.json > methods." },
        "madhab": { "type": "string", "enum": ["shafi", "hanafi"], "description": "City-level Asr madhab override." },
        "notes": { "type": "string", "description": "Only present together with an override." }
      }
    },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iso2", "iso3", "name", "continent", "defaultMethod", "methodSource", "defaultMadhab"],
      "properties": {
        "iso2": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "iso3": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "name": { "type": "string", "minLength": 1 },
        "nameAr": { "type": "string", "minLength": 1 },
        "continent": { "type": "string", "enum": ["AF", "AN", "AS", "EU", "NA", "OC", "SA"] },
        "defaultMethod": { "type": "string", "description": "Keys methods.json > methods, or the fallback method." },
        "methodSource": { "type": "string", "enum": ["national", "regional", "default"] },
        "defaultMadhab": { "type": "string", "enum": ["shafi", "hanafi"] },
        "alternatives": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "pendingMethods": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Keys methods.json > unimplemented." },
        "aliasesEn": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "aliasesAr": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "notes": { "type": "string" }
      }
    },
    "timezone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone", "rawOffsetMinutes", "observesDst", "dstOffsetMinutes",
        "offsetVariesDuringYear", "offsetMinutesMin", "offsetMinutesMax",
        "offsetMinutesOnJanuarySample", "offsetMinutesOnJulySample"
      ],
      "properties": {
        "timezone": { "type": "string", "minLength": 1, "description": "IANA time zone id." },
        "rawOffsetMinutes": { "type": "integer", "minimum": -720, "maximum": 840, "description": "Standard-time UTC offset in minutes." },
        "observesDst": { "type": "boolean" },
        "dstOffsetMinutes": { "type": "integer", "minimum": 0, "maximum": 120 },
        "offsetVariesDuringYear": { "type": "boolean", "description": "True when the monthly samples differ; the offset then has to be derived from the IANA zone." },
        "offsetMinutesMin": { "type": "integer", "minimum": -720, "maximum": 840 },
        "offsetMinutesMax": { "type": "integer", "minimum": -720, "maximum": 840 },
        "offsetMinutesOnJanuarySample": { "type": "integer", "minimum": -720, "maximum": 840 },
        "offsetMinutesOnJulySample": { "type": "integer", "minimum": -720, "maximum": 840 }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "aladhanMethodId", "fajrAngle", "maghribMinutes", "maghribRule"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Method key accepted by GET /api/prayer-times?method=" },
        "name": { "type": "string", "minLength": 1 },
        "nameAr": { "type": "string", "minLength": 1 },
        "authority": { "type": "string" },
        "aladhanMethodId": { "type": "integer", "minimum": 0, "maximum": 99 },
        "fajrAngle": { "type": "number", "minimum": 0, "maximum": 90 },
        "ishaAngle": { "type": ["number", "null"], "minimum": 0, "maximum": 90 },
        "ishaMinutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 240 },
        "ramadanIshaMinutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 240 },
        "maghribAngle": { "type": ["number", "null"], "minimum": 0, "maximum": 90 },
        "maghribMinutes": { "type": "integer", "minimum": 0, "maximum": 60, "description": "Minutes added to sunset; 0 for every implemented method." },
        "maghribRule": { "type": "string", "enum": ["sunset", "angle", "sunset_plus_minutes"] },
        "tuning": { "type": ["object", "null"], "description": "Published minute adjustments; not applied by the runtime." },
        "rounding": { "type": ["string", "null"], "enum": ["nearest", "up", "none", null] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "unimplementedMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "aladhanMethodId", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "nameAr": { "type": "string" },
        "authority": { "type": "string" },
        "aladhanMethodId": { "type": "integer", "minimum": 0, "maximum": 99 },
        "fajrAngle": { "type": ["number", "null"], "minimum": 0, "maximum": 90 },
        "ishaAngle": { "type": ["number", "null"], "minimum": 0, "maximum": 90 },
        "ishaMinutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 240 },
        "maghribAngle": { "type": ["number", "null"], "minimum": 0, "maximum": 90 },
        "maghribMinutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 60 },
        "midnightRule": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "documents": {
    "citiesDocument": {
      "type": "object",
      "required": ["schemaVersion", "cities"],
      "properties": {
        "schemaVersion": { "type": "integer", "enum": [1] },
        "cities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/city" } }
      }
    },
    "countriesDocument": {
      "type": "object",
      "required": ["schemaVersion", "countries"],
      "properties": {
        "schemaVersion": { "type": "integer", "enum": [1] },
        "countries": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/country" } }
      }
    },
    "timezonesDocument": {
      "type": "object",
      "required": ["schemaVersion", "timezones"],
      "properties": {
        "schemaVersion": { "type": "integer", "enum": [1] },
        "timezones": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/timezone" } }
      }
    },
    "methodsDocument": {
      "type": "object",
      "required": ["schemaVersion", "fallbackMethod", "methods", "unimplemented"],
      "properties": {
        "schemaVersion": { "type": "integer", "enum": [1] },
        "fallbackMethod": { "type": "string" },
        "methods": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/method" } },
        "unimplemented": { "type": "object", "additionalProperties": { "$ref": "#/$defs/unimplementedMethod" } }
      }
    },
    "metaDocument": {
      "type": "object",
      "required": ["schemaVersion", "dataset", "version", "generatedAt", "counts", "resolution"],
      "properties": {
        "schemaVersion": { "type": "integer", "enum": [1] },
        "dataset": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "minLength": 1 },
        "counts": { "type": "object" },
        "resolution": { "type": "object" }
      }
    }
  }
}

